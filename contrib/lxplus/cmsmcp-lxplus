#!/bin/bash
# cmsmcp with CERN lxplus settings; see "CERN lxplus setup" in the README.
# Use it in place of `cmsmcp` for every command and as the MCP server command.
REPO=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)
DATA=$HOME/private/cmsmcp                      # ~/private: no access for other users
mkdir -p -m 700 "$DATA/config" "$DATA/state"
export CMSMCP_CONFIG_DIR=$DATA/config          # secrets + cmsmcp.env
export CMSMCP_STATE_DIR=$DATA/state            # SSO cookies, audit log, downloads
export PLAYWRIGHT_BROWSERS_PATH=$DATA/pw       # headless Chromium
unset CMSMCP_LXPLUS_USER                       # lxplus SSH tools: AFS refuses their Unix socket
export X509_USER_PROXY=$HOME/x509up_u$(id -u)  # grid proxy on AFS, valid on every node
export CMSMCP_GRID_CERT_FILE=$X509_USER_PROXY
export CMSMCP_GRID_KEY_FILE=$X509_USER_PROXY
case ":$PATH:" in *:/cvmfs/cms.cern.ch/common:*) ;; *) PATH=$PATH:/cvmfs/cms.cern.ch/common ;; esac
exec "$REPO/.venv/bin/cmsmcp" "$@"
